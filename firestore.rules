rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // Helper — is the caller a signed-in admin dashboard user?
    // Requires a custom claim "admin: true" set via the Admin SDK.
    // -----------------------------------------------------------------------
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // -----------------------------------------------------------------------
    // Roster — Admin SDK / server only.
    // Client rules block everything except for an admin manually overriding.
    // -----------------------------------------------------------------------
    match /roster/{studentId} {
      allow read, update, delete: if false;
      allow create: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // Public Status — parallel collection for the search lookup page.
    // No PII exposed. Written by the server during joinList transaction.
    // -----------------------------------------------------------------------
    match /status/{studentId} {
      allow read: if true;
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // Queue
    //   read   : admin only — prevents exposing PII of all registrants.
    //   create : one registration per student, no prior queue or wait record.
    //            Student MUST exist on the roster.
    //   update : admin only — cancelTicket sets queuingStatus = "cancelled".
    //   delete : never.
    // -----------------------------------------------------------------------
    match /queue/{studentId} {
      allow read: if isAdmin();
      allow create: if
        !exists(/databases/$(database)/documents/queue/$(studentId)) &&
        !exists(/databases/$(database)/documents/wait/$(studentId))  &&
        exists(/databases/$(database)/documents/roster/$(studentId));
      allow update: if isAdmin();
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // Wait — identical rules to queue.
    // -----------------------------------------------------------------------
    match /wait/{studentId} {
      allow read: if isAdmin();
      allow create: if
        !exists(/databases/$(database)/documents/queue/$(studentId)) &&
        !exists(/databases/$(database)/documents/wait/$(studentId))  &&
        exists(/databases/$(database)/documents/roster/$(studentId));
      allow update: if isAdmin();
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // Counter
    //   read   : always open (progress bars, slot dropdowns).
    //   create : admin only (initSlotDocs script).
    //   update : shape-constrained —
    //     • Aggregate doc ("count"): any single field may change by ±1,
    //       but decrements are admin-only.
    //     • Slot docs: only the `count` field may change by ±1,
    //       but decrements are admin-only.
    //   delete : never.
    // -----------------------------------------------------------------------
    match /counter/{docId} {
      allow read: if true;
      allow create: if isAdmin();
      allow delete: if false;

      allow update: if docId == "count"
        ? (
           request.resource.data.diff(resource.data).affectedKeys().size() == 1 &&
           (
             (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['queueCount']) &&
               (request.resource.data.queueCount == resource.data.queueCount + 1 ||
               (isAdmin() && request.resource.data.queueCount == resource.data.queueCount - 1)))
             ||
             (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['waitingCount']) &&
               (request.resource.data.waitingCount == resource.data.waitingCount + 1 ||
               (isAdmin() && request.resource.data.waitingCount == resource.data.waitingCount - 1)))
             ||
             (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['waitingToQueueCount']) &&
               (request.resource.data.waitingToQueueCount == resource.data.waitingToQueueCount + 1 ||
               (isAdmin() && request.resource.data.waitingToQueueCount == resource.data.waitingToQueueCount - 1)))
             ||
             (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registerCount']) &&
               (request.resource.data.registerCount == resource.data.registerCount + 1 ||
               (isAdmin() && request.resource.data.registerCount == resource.data.registerCount - 1)))
             ||
             (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredCount']) &&
               (request.resource.data.registeredCount == resource.data.registeredCount + 1 ||
               (isAdmin() && request.resource.data.registeredCount == resource.data.registeredCount - 1)))
           )
          )
        : (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["count"]) &&
           (request.resource.data.count == resource.data.count + 1 ||
           (isAdmin() && request.resource.data.count == resource.data.count - 1)));
    }

    // -----------------------------------------------------------------------
    // Registration & Cancel — admin dashboard only.
    // -----------------------------------------------------------------------
    match /registration/{ticketNumber} {
      allow read, write: if isAdmin();
    }
    match /cancel/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
